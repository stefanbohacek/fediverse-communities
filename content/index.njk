---
layout: layout-main.njk
---

<div class=" mt-5">
  <div class="row">
    <div class="col-12">
      <h1 class="fw-bold mb-3">
        Find your community
      </h1>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <p>
        Fediverse is made up of many diverse communities. Here are some of the most well-maintained ones.
      </p>
    </div>
  </div>
  <div class="row mt-3 mb-2">
    <div class="col-12">
      <form id="filter-form" class="d-flex align-items-end gap-4 flex-wrap">
        <div>
          <label for="sort-by" class="form-label mb-1">Sort by</label>
          <select id="sort-by" class="form-select">
            <option value="alphabetical">Alphabetical</option>
            <option value="size-desc">Most members</option>
            <option value="size-asc">Fewest members</option>
            <option value="age-asc">Oldest first</option>
            <option value="age-desc">Newest first</option>
          </select>
        </div>
        <div>
          <label for="community-size" class="form-label mb-1">Community size</label>
          <select id="community-size" class="form-select">
            <option value="">Any size</option>
            <option value="small">Small</option>
            <option value="medium">Medium</option>
            <option value="large">Large</option>
          </select>
        </div>
        <div>
          <label for="community-age" class="form-label mb-1">Community age</label>
          <select id="community-age" class="form-select">
            <option value="">Any age</option>
            <option value="established">Established</option>
            <option value="new">New</option>
          </select>
        </div>
        <div class="form-check mb-2">
          <input class="form-check-input" type="checkbox" id="annual-report">
            <label class="form-check-label" for="annual-report">Published last year's annual report</label>
          </div>
        </form>
      </div>
    </div>
    <div class="row mt-3 mb-2">
      <div class="col-12">
        <button id="clear-filters" type="button" class="btn btn-link btn-sm p-0 small mb-1" disabled>Reset filters</button>
        <p id="communities-updated" class="small mb-0" data-fetched-at="{{ communities.fetched_at }}">Information updated
          <span class="text-body-tertiary">...</span>.</p>
      </div>
    </div>
    {% set linkLabels = {
      "explore_and_join": "Explore and join",
      "community_blog": "Community blog",
      "moderation": "Moderation & rules",
      "learn_more": "Learn more"
    } %}
    <div id="communities-grid" class="row g-3 mt-2">
      {% for community in communities.items %}
        {% set lastReport = community.annual_reports | first %}
        <div class="col-12 col-md-6 col-lg-6" data-name="{{ community.name }}" data-members="{{ community.active_month }}" data-year="{{ community.year }}" data-annual-report-year="{{ lastReport.year if lastReport else '' }}">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="card-title fw-bold fs-5 mb-2">{{ community.name }}</h2>
              <div class="d-flex flex-wrap gap-2 mb-3">
                {% if community.software %}
                  <span class="badge bg-dark text-capitalize">{{ community.software }}</span>
                {% endif %}
                <span class="badge bg-secondary">Created in {{ community.year }}</span>
                <span class="badge bg-info">{{ community.active_month | formatNumber }} active members</span>
              </div>
              <p class="card-text">{{ community.description }}</p>
              {% if community.membership_cost %}
                <p class="card-text">
                  <strong>Membership:</strong>
                  {{ community.membership_cost }}</p>
              {% endif %}
              <ul>
                {% for key, url in community.links %}
                  {% if url %}
                    <li>
                      <a href="{{ url }}">{{ linkLabels[key] }}</a>
                    </li>
                  {% endif %}
                {% endfor %}
                {% if community.annual_reports | length %}
                  <li>
                    <select class="form-select form-select-sm w-auto annual-reports-select">
                      <option value="">View annual reports</option>
                      {% for report in community.annual_reports %}
                        <option value="{{ report.url }}">{{ report.year }}</option>
                      {% endfor %}
                    </select>
                  </li>
                {% endif %}
              </ul>
            </div>
            {% if community.team | length %}
              <div class="card-footer">
                <p class="small text-body-secondary mb-1">Moderation team</p>
                <div class="team-container reverse">
                  {% for member in community.team %}
                    <img src="{{ member.profile_image }}" alt="{{ member.name }}">
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="row mt-5">
        <div class="col-12">
          <p>
            <a class="btn btn-primary mt-4" href="https://friends.jointhefediverse.net/">Find your friends</a>
            <a class="btn btn-outline-primary mt-4" href="https://stefanbohacek.com/blog/how-to-join-mastodon-and-the-fediverse/">
              More resources</a>
          </p>
        </div>
      </div>
    </div>